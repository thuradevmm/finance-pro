{
  "name": "finance-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-next-dev-types.mjs && next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint",
    "db:login": "npx supabase login",
    "db:link": "npx supabase link",
    "db:status": "npx supabase status",
    "db:local:status": "npx supabase status",
    "db:migration:check": "node scripts/check-supabase-migrations.mjs",
    "db:migration:seal": "node scripts/seal-supabase-migrations.mjs",
    "db:local:migrations": "npx supabase migration list --local",
    "db:local:reset:safe": "node scripts/safe-local-reset.mjs",
    "db:local:reset:ci": "npx supabase db reset --local --no-seed",
    "db:remote:migrations": "npx supabase migration list --linked",
    "db:remote:check": "node scripts/check-linked-migrations.mjs",
    "db:remote:verify": "node scripts/check-linked-migrations.mjs --require-synced",
    "db:deploy": "node scripts/deploy-supabase-migrations.mjs",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:new": "npx supabase migration new",
    "db:diff": "npx supabase db diff",
    "db:migration:list": "npx supabase migration list",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:types:local": "npx supabase gen types typescript --local --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "fflate": "^0.8.3",
    "next": "^16.2.11",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.18",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "supabase": "2.107.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.24",
      "sharp": "^0.35.3"
    }
  }
}
